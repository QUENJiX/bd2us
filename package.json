{
  "name": "bd2us-platform",
  "version": "2.0.0",
  "private": true,
  "description": "BD2US dynamic guidance platform for Bangladeshi students applying to U.S. colleges",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "generate:legacy-content": "node scripts/generate-legacy-content.mjs",
    "generate:college-catalog": "node scripts/generate-college-catalog.mjs",
    "generate:college-review-ledger": "node scripts/generate-college-review-ledger.mjs",
    "verify:college-launch": "node scripts/verify-college-launch-gate.mjs",
    "generate:content": "npm run generate:legacy-content && npm run generate:college-catalog"
  },
  "dependencies": {
    "@fontsource-variable/literata": "^5.3.0",
    "@fontsource/atkinson-hyperlegible": "^5.3.0",
    "@supabase/ssr": "^0.7.0",
    "@supabase/supabase-js": "^2.57.4",
    "next": "^16.2.11",
    "pdf-lib": "^1.17.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.14",
    "@types/node": "^22.18.6",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "eslint": "^9.36.0",
    "eslint-config-next": "^16.2.11",
    "exceljs": "^4.4.0",
    "tailwindcss": "^4.1.14",
    "typescript": "^5.9.2"
  },
  "license": "MIT"
}
