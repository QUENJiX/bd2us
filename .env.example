# Public domain for auth redirects. Sharing metadata uses the canonical domain in lib/site.ts.
NEXT_PUBLIC_SITE_URL=https://bd2us.com

# Add these three values after creating a Supabase project.
# The secret value is private: keep it server-side and never commit it.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
