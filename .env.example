# Required when deployed. Use your temporary Vercel URL first, then switch to www.bd2us.app.
NEXT_PUBLIC_SITE_URL=https://www.bd2us.app

# Add these three values after creating a Supabase project.
# Paste the modern Supabase publishable key into ANON_KEY and the secret key into
# SERVICE_ROLE_KEY. The secret value is private: keep it server-side and never commit it.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
