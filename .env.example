# Required when deployed. Use your temporary Vercel URL first, then switch to www.bd2us.app.
NEXT_PUBLIC_SITE_URL=https://www.bd2us.app

# Add these three values after creating a Supabase project.
# The secret value is private: keep it server-side and never commit it.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
